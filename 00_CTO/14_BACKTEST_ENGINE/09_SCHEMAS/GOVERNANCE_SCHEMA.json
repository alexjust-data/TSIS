{
  "$id": "https://tsis.local/schemas/backtest-governance-v0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "anyOf": [
    {
      "required": [
        "entries"
      ]
    },
    {
      "required": [
        "gates"
      ]
    }
  ],
  "properties": {
    "as_of": {
      "format": "date",
      "type": "string"
    },
    "entries": {
      "items": {
        "anyOf": [
          {
            "required": [
              "decision_id",
              "domain",
              "title",
              "status"
            ]
          },
          {
            "required": [
              "policy_id",
              "domain",
              "title",
              "status"
            ]
          },
          {
            "required": [
              "capability_id",
              "status",
              "decision_ids",
              "policy_ids"
            ]
          },
          {
            "required": [
              "exception_id",
              "type",
              "status",
              "scope"
            ]
          }
        ],
        "minProperties": 4,
        "type": "object"
      },
      "type": "array"
    },
    "files": {
      "type": "array"
    },
    "gates": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "authorized_scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "gate_id": {
            "minLength": 1,
            "type": "string"
          },
          "non_claims": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "gate_id",
          "title",
          "status",
          "authorized_scope",
          "evidence",
          "non_claims"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "matrix_id": {
      "minLength": 1,
      "type": "string"
    },
    "next_gate": {
      "type": "object"
    },
    "register_id": {
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "source_root": {
      "type": "string"
    }
  },
  "required": [
    "register_id",
    "as_of"
  ],
  "title": "TSIS Backtest Governance Register",
  "type": "object"
}
