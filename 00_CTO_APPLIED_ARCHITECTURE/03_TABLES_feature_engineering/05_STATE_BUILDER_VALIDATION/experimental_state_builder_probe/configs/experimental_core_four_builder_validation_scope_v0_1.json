{
  "authority": {
    "bounded_sample_data_read_allowed": true,
    "dataset_promotion_authorized": false,
    "experimental_formula_execution_allowed": true,
    "experimental_resolution_records_allowed": true,
    "full_data_read_allowed": false,
    "market_state_integration_authorized": false,
    "physical_materialization_authorized": false,
    "production_builder_authorized": false,
    "quote_dependent_builder_execution_authorized": false,
    "state_consumption_authorized": false,
    "state_materialization_allowed": false,
    "writes_to_source_allowed": false
  },
  "authorization_artifact": "../experimental_core_four_builder_validation_authorization_v0_1.md",
  "formula_rules": {
    "daily__gap_pct": {
      "formula_id": "daily_open_over_prior_close_minus_one_v0_1",
      "inputs": [
        "open",
        "prior_close"
      ],
      "rule": "open / prior_close - 1; only after session open",
      "source_alias": "004_master_daily_table"
    },
    "daily__open_price": {
      "formula_id": "daily_open_price_after_session_open_v0_1",
      "inputs": [
        "open"
      ],
      "rule": "open from matched daily row; only after session open",
      "source_alias": "004_master_daily_table"
    },
    "daily__prior_close": {
      "formula_id": "daily_prior_close_value_v0_1",
      "inputs": [
        "prior_close"
      ],
      "rule": "prior_close from matched daily row",
      "source_alias": "004_master_daily_table"
    },
    "daily__rvol_20d": {
      "formula_id": "session_volume_to_time_over_prior_20_volume_mean_v0_1",
      "inputs": [
        "session_volume_to_time",
        "volume_20d_avg"
      ],
      "rule": "session_volume_to_time / volume_20d_avg; final daily rvol is not consumed intraday",
      "source_alias": "004_master_daily_table+014_master_intraday_bar_table_candidate"
    },
    "daily__volume_20d_avg": {
      "formula_id": "prior_20_session_volume_mean_v0_1",
      "inputs": [
        "volume"
      ],
      "rule": "mean(volume) over prior 20 daily rows for ticker",
      "source_alias": "004_master_daily_table"
    },
    "intraday__bar_close_price": {
      "formula_id": "selected_closed_bar_close_v0_1",
      "inputs": [
        "close"
      ],
      "rule": "close from max(ts_utc) <= decision_timestamp",
      "source_alias": "014_master_intraday_bar_table_candidate"
    },
    "intraday__bar_volume": {
      "formula_id": "selected_closed_bar_volume_v0_1",
      "inputs": [
        "volume"
      ],
      "rule": "volume from max(ts_utc) <= decision_timestamp",
      "source_alias": "014_master_intraday_bar_table_candidate"
    },
    "intraday__high_so_far": {
      "formula_id": "closed_bar_high_so_far_max_v0_1",
      "inputs": [
        "high"
      ],
      "rule": "max(high) over closed bars <= decision_timestamp",
      "source_alias": "014_master_intraday_bar_table_candidate"
    },
    "intraday__low_so_far": {
      "formula_id": "closed_bar_low_so_far_min_v0_1",
      "inputs": [
        "low"
      ],
      "rule": "min(low) over closed bars <= decision_timestamp",
      "source_alias": "014_master_intraday_bar_table_candidate"
    },
    "intraday__range_so_far_ratio": {
      "formula_id": "high_so_far_over_low_so_far_minus_one_v0_1",
      "inputs": [
        "high_so_far",
        "low_so_far"
      ],
      "rule": "high_so_far / low_so_far - 1; denominator > 0",
      "source_alias": "014_master_intraday_bar_table_candidate"
    },
    "intraday__return_vs_prior_close_ratio": {
      "formula_id": "closed_bar_close_over_prior_close_minus_one_v0_1",
      "inputs": [
        "close",
        "prior_close"
      ],
      "rule": "close / prior_close - 1",
      "source_alias": "004_master_daily_table+014_master_intraday_bar_table_candidate"
    },
    "intraday__return_vs_prior_close_ratio_as_location": {
      "formula_id": "location_closed_bar_close_over_prior_close_minus_one_v0_1",
      "inputs": [
        "close",
        "prior_close"
      ],
      "rule": "same numeric formula as movement; semantic owner is Price Location / Structure",
      "source_alias": "004_master_daily_table+014_master_intraday_bar_table_candidate"
    },
    "intraday__return_vs_session_open_ratio": {
      "formula_id": "closed_bar_close_over_session_open_minus_one_v0_1",
      "inputs": [
        "close",
        "open"
      ],
      "rule": "close / session_open - 1; session open must be known",
      "source_alias": "004_master_daily_table+014_master_intraday_bar_table_candidate"
    },
    "intraday__return_vs_session_open_ratio_as_location": {
      "formula_id": "location_closed_bar_close_over_session_open_minus_one_v0_1",
      "inputs": [
        "close",
        "open"
      ],
      "rule": "same numeric formula as movement; semantic owner is Price Location / Structure",
      "source_alias": "004_master_daily_table+014_master_intraday_bar_table_candidate"
    },
    "intraday__session_volume_to_time": {
      "formula_id": "closed_bar_session_volume_sum_v0_1",
      "inputs": [
        "volume"
      ],
      "rule": "sum(volume) over closed bars <= decision_timestamp in session",
      "source_alias": "014_master_intraday_bar_table_candidate"
    }
  },
  "global_limits": {
    "full_scan_allowed": false,
    "maximum_decision_timestamps_per_session": 5,
